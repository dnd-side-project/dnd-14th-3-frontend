# 환경 변수 예시
# 예시 템플릿이니 복사해서 사용하시고, 이곳에 직접 작성하면 안됩니다!!!!

# API
# VITE_API_BASE_URL=http://localhost:3000

# 카카오맵 API Key
# VITE_KAKAO_MAP_APP_KEY=your_kakao_map_app_key_here

# MSW (개발 시 API 모킹, 설정 시에만 worker 동작)
# VITE_MSW_ENABLED=true

# 기타 환경 변수
# VITE_SENTRY_DSN=
# VITE_GA_TRACKING_ID=

# 실시간 동행 매칭 시간 만료 테스트
#VITE_MSW_MATCH_SSE_SCENARIO=expired    

# 실시간 동행 매칭 제안 거절 테스트
#VITE_MSW_MATCH_SSE_SCENARIO=proposal-rejected

# 실시간 동행 백오프 테스트 (연결 끊김)
#VITE_MSW_MATCH_SSE_SCENARIO=disconnect       
#VITE_MSW_MATCH_WS_SCENARIO=disconnect
